# How to call Claude: "api" (Anthropic API, prepaid credits; required for the public beta)
# or "claude-code" (local Claude Code subscription via `claude -p`; local testing only)
LLM_BACKEND=claude-code

# Anthropic (Claude). The API key is only needed with LLM_BACKEND=api
ANTHROPIC_API_KEY=
# Default model for every LLM step
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional per-step overrides (fall back to ANTHROPIC_MODEL when empty)
ANTHROPIC_MODEL_DETECTION=
# Verdicts (and context resolution) need careful reasoning with figures. Sonnet 5.5 matched
# Opus 5.5 on the gold set (17/17) at about half the cost (2026-10-11).
ANTHROPIC_MODEL_VERDICT=claude-sonnet-5-5

# Transcription
TRANSCRIPTION_PROVIDER=elevenlabs
TRANSCRIPTION_API_KEY=

# Evidence sources
GOOGLE_FACTCHECK_API_KEY=
# Web search for official and general sources (free plan: 1,000 credits/month)
TAVILY_API_KEY=

# Email reports (any SMTP provider). Gmail / Google Workspace: smtp.gmail.com, port 587,
# your address as user and an app password (myaccount.google.com/apppasswords).
# Microsoft 365 / Outlook: smtp.office365.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address; defaults to SMTP_USER
EMAIL_FROM=
