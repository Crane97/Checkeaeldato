# How to call Claude: "api" (Anthropic API, prepaid credits; required for the public beta)
# or "claude-code" (local Claude Code subscription via `claude -p`; local testing only)
LLM_BACKEND=claude-code

# Anthropic (Claude). The API key is only needed with LLM_BACKEND=api
ANTHROPIC_API_KEY=
# Default model for every LLM step
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional per-step overrides (fall back to ANTHROPIC_MODEL when empty)
ANTHROPIC_MODEL_DETECTION=
# Verdicts (and context resolution) need careful reasoning with figures. Sonnet 5.5 matched
# Opus 5.5 on the gold set (17/17) at about half the cost (2026-10-11).
ANTHROPIC_MODEL_VERDICT=claude-sonnet-5-5

# Transcription
TRANSCRIPTION_PROVIDER=elevenlabs
TRANSCRIPTION_API_KEY=

# Evidence sources
GOOGLE_FACTCHECK_API_KEY=
# Web search for official and general sources (free plan: 1,000 credits/month)
TAVILY_API_KEY=
# Búsquedas: "basic" (1 crédito) o "advanced" (2); resultados por búsqueda (1-20)
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
# Días que se reutiliza una búsqueda guardada en data/cache/search/ (--no-cache la salta)
TAVILY_CACHE_DAYS=30
# Afirmaciones procesadas a la vez en evidencia y veredicto (1 = una a una)
PIPELINE_CONCURRENCY=4

# Email reports (any SMTP provider). Gmail / Google Workspace: smtp.gmail.com, port 587,
# your address as user and an app password (myaccount.google.com/apppasswords).
# Microsoft 365 / Outlook: smtp.office365.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address; defaults to SMTP_USER
EMAIL_FROM=

# Razonamiento interno de Claude SOLO en el veredicto. Sin definir: lo que haga el modelo por
# defecto (los modelos 5.5 ya razonan de forma adaptativa). true/false para forzarlo.
# Con la API, en modelos 4.6 y posteriores la profundidad se controla con el esfuerzo
# (low|medium|high|xhigh|max); el presupuesto en tokens solo lo admiten los modelos hasta 4.5.
# Con LLM_BACKEND=claude-code se traduce a `claude -p --effort` (false = low).
VERDICT_THINKING=
VERDICT_EFFORT=
VERDICT_THINKING_BUDGET=

# Base de conocimiento oficial: Postgres del proyecto de DESARROLLO de Supabase (migraciones,
# ingesta y tests de integración). Panel de Supabase → Connect → cadena de conexión.
SUPABASE_DB_URL=
# El MCP de Supabase de Claude Code NO va aquí: exporta CHECKEA_SUPABASE_TOKEN en tu terminal
# (o en ~/.zshrc); .mcp.json solo guarda la referencia ${CHECKEA_SUPABASE_TOKEN}.
# Destinatario de las alertas de la ingesta diaria (`conocimiento ingerir --avisar`)
ALERT_EMAIL_TO=
